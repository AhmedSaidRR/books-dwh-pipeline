# ---------------------------------------------------------------------------
# Copy this file to `.env` (docker compose reads it automatically).
#   cp .env.example .env        # macOS / Linux
#   copy .env.example .env      # Windows cmd
# ---------------------------------------------------------------------------

# Credentials used both by the `warehouse` container and by the Python loader.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse

# Scraper tuning (books.toscrape.com is a sandbox built for scraping practice).
SCRAPER_BASE_URL=https://books.toscrape.com/
SCRAPER_REQUEST_DELAY=0.1
SCRAPER_TIMEOUT=20
SCRAPER_MAX_RETRIES=3
# Leave empty to crawl every category (50 categories, ~1000 books).
SCRAPER_MAX_CATEGORIES=

# Where raw JSON / processed parquet files are written.
DATA_DIR=./data

# Only needed on Linux, keeps bind-mounted files owned by your user.
AIRFLOW_UID=50000
